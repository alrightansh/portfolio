# Response headers on Cloudflare (Workers static assets, see DEPLOY.md). Same policy as security-headers.conf and the
# cache rules in nginx.conf, which the Docker build uses: change both together. Rules that match one path add up, so
# the cache rules never overlap. HTML keeps Cloudflare's default "public, max-age=0, must-revalidate" (nginx: no-cache).

/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Map data, images and fonts carry a version in their file names (bump -vN when one changes): 30 days.
/*.bin
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000
/*.png
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.woff2
  Cache-Control: public, max-age=2592000

# Content-hashed bundles never change. Last, so it replaces a rule above if Astro ever puts an image here.
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
