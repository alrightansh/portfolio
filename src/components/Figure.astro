---
// A real project image (WebP in public/work/ at the given widths) with the clip reveal, caption and credit.
interface Props { src: string; alt: string; w: number; h: number; widths?: number[]; caption?: string; credit?: string; sizes?: string; eager?: boolean }
const { src, alt, w, h, widths = [800, 1600], caption, credit, sizes = "(max-width: 1100px) 100vw, 60vw", eager = false } = Astro.props;
const srcset = widths.map((x) => `${src}-${x}.webp ${x}w`).join(", ");
---
<figure class="fig" data-img>
  <div class="fig-mask">
    <img src={`${src}-${widths[widths.length - 1]}.webp`} srcset={srcset} sizes={sizes} width={w} height={h} alt={alt}
      loading={eager ? "eager" : "lazy"} decoding="async" />
  </div>
  {(caption || credit) && (
    <figcaption>
      {caption && <span>{caption}</span>}
      {credit && <span class="credit">{credit}</span>}
    </figcaption>
  )}
</figure>
