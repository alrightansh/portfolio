---
// The state of alrightansh: a flight over a living contour field into the void.
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Anshuman Choudhary | Geospatial Data Scientist | alrightansh</title>
  <meta name="description" content="Anshuman Choudhary, geospatial data scientist: utility network migrations, electric and gas UPDM, remote sensing and GeoAI, told through maps." />
  <link rel="canonical" href="https://alrightansh.com/" />
  <meta property="og:title" content="The state of alrightansh" />
  <meta property="og:description" content="Maps, models and machines: a flight through the work of Anshuman Choudhary." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#07090f" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/OverusedGrotesk-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/OverusedGrotesk-Medium.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/research/neugal-dem.bin" as="fetch" crossorigin="anonymous" />
  <link rel="preload" href="/research/osm.json" as="fetch" crossorigin="anonymous" />
  <style is:global>
    @font-face { font-family: "Overused Grotesk"; src: url("/fonts/OverusedGrotesk-Regular.woff2") format("woff2"); font-weight: 400; font-display: swap; }
    @font-face { font-family: "Overused Grotesk"; src: url("/fonts/OverusedGrotesk-Medium.woff2") format("woff2"); font-weight: 500; font-display: swap; }
    :root { --bg: #07090f; --fg: #d2e4f2; --dim: #a9b6c4; --accent: #8fd3ff; --pad: 40px; }
    * { box-sizing: border-box; }
    html, body { margin: 0; height: 100%; overflow: hidden; background: var(--bg); color: var(--fg);
      overscroll-behavior: none; }
    body { font-family: "Overused Grotesk", system-ui, sans-serif; -webkit-font-smoothing: antialiased;
      touch-action: none; user-select: none; }
    a { color: inherit; text-decoration: none; }
    canvas#scene { position: fixed; inset: 0; width: 100%; height: 100%; display: block; }

    /* masked character reveal */
    .wd { display: inline-block; white-space: nowrap; }
    .ch { display: inline-block; overflow: hidden; vertical-align: bottom; line-height: 1.2; }
    .ch > span { display: inline-block; will-change: transform; }
    .swap { display: inline-grid; }
    .swap-layer { grid-area: 1 / 1; white-space: nowrap; }

    /* chrome */
    .top { position: fixed; inset: 0 0 auto 0; z-index: 30; display: flex; align-items: center;
      justify-content: space-between; padding: 30px var(--pad); pointer-events: none; }
    .caps { font-size: 14px; letter-spacing: 0.02em; text-transform: uppercase; mix-blend-mode: difference; }
    .logo { position: absolute; left: 50%; top: 22px; transform: translateX(-50%); font-size: 21px;
      letter-spacing: -0.01em; mix-blend-mode: difference; pointer-events: auto; }
    .logo b { font-weight: 500; }
    #audioBtn { pointer-events: auto; cursor: pointer; display: inline-flex; gap: 10px; align-items: center;
      background: none; border: 0; color: inherit; font: inherit; padding: 0; }
    .eq { display: inline-flex; gap: 3px; align-items: center; height: 12px; }
    .eq i { width: 3px; height: 3px; border-radius: 2px; background: var(--fg); }
    .eq.on i { animation: eq 0.9s ease-in-out infinite alternate; }
    .eq.on i:nth-child(2) { animation-duration: 0.7s; animation-delay: 0.15s; }
    .eq.on i:nth-child(3) { animation-duration: 1.1s; animation-delay: 0.3s; }
    @keyframes eq { from { height: 3px; } to { height: 12px; } }
    .bl, .br { position: fixed; bottom: 40px; z-index: 30; }
    .bl { left: var(--pad); } .br { right: var(--pad); }

    /* hero */
    .hero { position: fixed; z-index: 12; margin: 0; font-weight: 400; font-size: 12vw; line-height: 1;
      letter-spacing: -0.02em; mix-blend-mode: difference; pointer-events: none; white-space: nowrap;
      opacity: var(--hero-fade, 1); }
    #heroA { top: 56px; left: var(--pad); }
    #heroB { bottom: 72px; right: var(--pad); }
    #heroP { position: fixed; z-index: 12; left: 50%; top: 50%; transform: translate(-50%, -50%); margin: 0;
      width: min(560px, 86vw); text-align: center; font-size: 18px; line-height: 1.4; letter-spacing: 0.02em;
      text-transform: uppercase; opacity: var(--hero-fade, 1); mix-blend-mode: difference; pointer-events: none; }

    /* station labels */
    #labels { position: fixed; z-index: 14; left: 50%; top: 52%; transform: translate(-50%, -50%);
      display: grid; pointer-events: none; }
    .st-label { grid-area: 1 / 1; display: flex; flex-direction: column; align-items: center; text-align: center;
      mix-blend-mode: difference; color: #fff; }
    .st-pre { font-size: 18px; letter-spacing: 0.02em; text-transform: uppercase; color: #bababa; margin-bottom: 10px; }
    .st-title { font-size: 8vw; line-height: 1; letter-spacing: -0.01em; white-space: nowrap; }
    .st-title sup { font-size: 0.32em; color: #bababa; vertical-align: top; margin-left: 0.08em; }
    .st-post { font-size: 2.56vw; line-height: 1.2; letter-spacing: -0.01em; color: #bababa; margin-top: 6px;
      max-width: 70vw; }
    .st-cap { margin-top: 22px; max-width: 620px; font-size: 14px; line-height: 1.55; letter-spacing: 0.02em;
      text-transform: uppercase; color: var(--fg); }
    .st-link { margin-top: 18px; font-size: 14px; letter-spacing: 0.02em; text-transform: uppercase;
      border-bottom: 1px solid currentColor; opacity: 0; transition: opacity 0.4s ease; }
    .st-label.on .st-link { opacity: 1; pointer-events: auto; }

    /* research stop */
    #research { position: fixed; inset: 0; z-index: 14; pointer-events: none; opacity: 0; transition: opacity 0.6s ease; }
    #research.on { opacity: 1; }
    .rs-head { position: absolute; left: var(--pad); top: 104px; max-width: 42vw; }
    .rs-pre, .rs-idx, .rs-unit { font-size: 14px; letter-spacing: 0.02em; text-transform: uppercase; }
    .rs-pre { color: var(--accent); }
    .rs-title { margin-top: 12px; font-size: 5.4vw; line-height: 1; letter-spacing: -0.02em; }
    .rs-sub { margin-top: 10px; font-size: 1.5vw; color: var(--dim); }
    .rs-eq { position: absolute; right: var(--pad); top: 110px; font-size: 24px; letter-spacing: 0.04em; color: rgba(210, 228, 242, 0.45);
      opacity: 0; transition: opacity 0.4s ease; }
    .rs-eq.on { opacity: 1; }
    .rs-eq span { display: inline-block; transition: color 0.35s ease, text-shadow 0.35s ease, transform 0.35s ease; }
    .rs-eq span.hot { color: #fff; text-shadow: 0 0 18px rgba(143, 211, 255, 0.95); transform: translateY(-3px); }
    .rs-step { position: absolute; left: var(--pad); bottom: 112px; width: min(470px, 38vw); }
    .rs-step .swap { display: grid; }
    .rs-idx { color: var(--dim); font-variant-numeric: tabular-nums; }
    .rs-name { margin-top: 10px; font-size: 34px; letter-spacing: -0.01em; }
    .rs-text { margin-top: 12px; min-height: 4.6em; font-size: 15px; line-height: 1.5; color: var(--fg); }
    .rs-text .swap-layer { white-space: normal; }
    .rs-bar { display: flex; gap: 6px; margin-top: 18px; }
    .rs-bar i { display: block; width: 26px; height: 2px; background: var(--fg); opacity: 0.18; transition: opacity 0.4s ease, width 0.4s ease; }
    .rs-bar i.on { opacity: 1; width: 42px; background: var(--accent); }
    .rs-stat { position: absolute; right: var(--pad); bottom: 112px; text-align: right; }
    .rs-num { font-size: 6.2vw; line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums;
      text-shadow: 0 0 30px rgba(143, 211, 255, 0.35); }
    .rs-unit { margin-top: 10px; color: var(--dim); }
    .rs-legend { display: flex; flex-wrap: wrap; gap: 8px 14px; justify-content: flex-end; margin-top: 14px; font-size: 12px;
      text-transform: uppercase; letter-spacing: 0.02em; opacity: 0; transform: translateY(6px);
      transition: opacity 0.3s ease, transform 0.3s ease; }
    .rs-legend.on { opacity: 1; transform: none; }
    .rs-legend span { display: inline-flex; align-items: center; }
    .rs-legend i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 6px; }
    .lg-low { background: #1f4079; } .lg-mod { background: #408cff; }
    .lg-high { background: #8cccff; } .lg-crit { background: #ff5c4d; }
    .lg-water { background: #9ed6ff; } .lg-soil { background: #e69457; }
    .rs-legend .lg-river { width: 18px; height: 3px; border-radius: 2px; background: #73b8ff; }
    .rs-legend .lg-stream { width: 18px; height: 1.5px; border-radius: 1px; background: #3873b8; }
    .rs-legend .lg-edge { width: 16px; height: 0; border-radius: 0; border-top: 1.5px solid var(--accent); }
    .rs-legend .lg-rain { width: 2px; height: 11px; border-radius: 1px; background: #b3d6ff; }
    .rs-legend .lg-village { width: 6px; height: 6px; background: #dbe8f5; }
    .rs-legend .lg-atrisk { width: 11px; height: 11px; border: 1.5px solid #ff6b57;
      background: radial-gradient(circle, #ff6b57 0 2px, transparent 2.5px); }
    .rs-legend .lg-road { width: 18px; height: 2px; border-radius: 1px; background: #ff6b57; }
    .rs-legend .lg-ramp { gap: 8px; }
    .rs-legend .lg-bar { width: 84px; height: 6px; border-radius: 3px; margin: 0;
      background: linear-gradient(90deg, #0f214d, #296bd9, #80ccff); }
    .rs-place { position: absolute; left: 0; top: 0; padding-left: 10px; margin-top: -8px; font-size: 12px;
      letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg); opacity: 0; white-space: nowrap;
      text-shadow: 0 0 10px rgba(7, 9, 15, 0.95), 0 0 3px rgba(7, 9, 15, 0.9); }
    .rs-place::before { content: ""; position: absolute; left: -3px; top: 50%; width: 6px; height: 6px; margin-top: -3px;
      border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 2px rgba(7, 9, 15, 0.55); }
    .rs-place.big { padding: 0; margin: 0; font-size: 15px; letter-spacing: 0.18em; }
    .rs-place.big::before { display: none; }
    .rs-north { position: absolute; left: 0; top: 0; width: 20px; height: 40px; margin: -20px 0 0 -10px; opacity: 0; }
    .rs-north svg { display: block; width: 20px; height: 40px; overflow: visible; }
    .rs-north text { fill: var(--fg); font-size: 10px; }
    .rs-north .nf { fill: var(--accent); }
    .rs-north .no { fill: none; stroke: var(--accent); stroke-width: 1; stroke-linejoin: round; }
    .rs-scale { position: absolute; left: 0; top: 0; opacity: 0; font-size: 11px; letter-spacing: 0.04em; white-space: nowrap;
      text-shadow: 0 0 8px rgba(7, 9, 15, 0.9); }
    .rs-scale i { display: block; height: 5px; margin-top: 4px; border: 1px solid var(--fg); border-top: 0; }
    .rs-attr { position: absolute; right: var(--pad); bottom: 84px; font-size: 10px; color: var(--dim); pointer-events: auto; }
    .rs-attr a { color: inherit; }

    /* outro */
    #outroLabel { position: fixed; z-index: 14; left: 50%; top: 46%; transform: translate(-50%, -50%);
      font-size: 8vw; line-height: 1; letter-spacing: -0.01em; color: #fff; white-space: nowrap;
      mix-blend-mode: difference; pointer-events: none; }
    #outroBtn { position: fixed; z-index: 15; left: 50%; top: 56%; padding: 18px 42px; border-radius: 19px;
      background: var(--accent); color: #07090f; font-size: 16px; opacity: 0;
      transition: opacity 360ms ease; transform: translate(-50%, 32px); }

    /* station ticks */
    #ticks { position: fixed; z-index: 20; bottom: 0; left: 50%; transform: translateX(-50%); display: flex;
      align-items: flex-end; gap: 4px; height: 80px; }
    .tick { width: 14px; height: 100%; display: flex; align-items: flex-end; justify-content: center;
      background: none; border: 0; padding: 0; cursor: pointer; }
    .tick i { display: block; width: 1px; height: 0; background: var(--fg); opacity: 0.15; }

    /* preloader */
    #loader { position: fixed; inset: 0; z-index: 90; background: var(--bg); transition: opacity 0.8s ease, visibility 0.8s; }
    #loader.done { opacity: 0; visibility: hidden; }
    .loader-grid { position: absolute; inset: 0;
      background-image: radial-gradient(rgba(143, 211, 255, 0.10) 1px, transparent 1.2px);
      background-size: 22px 22px; background-position: 11px 11px; }
    #loaderBar { position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: var(--accent);
      transform-origin: 0 50%; transform: scaleX(0); }
    #loader .logo { mix-blend-mode: normal; }
    #loaderPct { position: absolute; left: var(--pad); bottom: 24px; font-size: clamp(5rem, 14vw, 12rem);
      line-height: 1; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; }

    /* phones: one column, text in bands above and below the 3D object, safe-area aware */
    @media (max-width: 768px) {
      :root { --pad: 20px; --top: calc(20px + env(safe-area-inset-top)); --bottom: calc(28px + env(safe-area-inset-bottom)); }
      .top { padding: var(--top) var(--pad) 0; }
      .logo { top: calc(var(--top) - 4px); font-size: 19px; }
      .caps { font-size: 11px; }
      .bl, .br { bottom: var(--bottom); }
      .br { display: none; }
      #hint { position: fixed; right: var(--pad); bottom: var(--bottom); }
      #audioBtn { margin-left: auto; }
      .hero { font-size: 17.5vw; }
      #heroA { top: calc(var(--top) + 56px); } #heroB { bottom: calc(var(--bottom) + 64px); }
      #heroP { font-size: 13px; line-height: 1.5; width: calc(100vw - 2 * var(--pad)); }

      #labels { left: var(--pad); right: var(--pad); top: calc(var(--top) + 64px); bottom: calc(var(--bottom) + 72px);
        transform: none; }
      .st-label { height: 100%; justify-content: flex-start; }
      .st-title + * { margin-top: auto; }
      .st-pre { font-size: 13px; margin-bottom: 8px; }
      .st-title, #outroLabel { font-size: 12.5vw; line-height: 1.02; white-space: normal; text-align: center; }
      .st-title sup { font-size: 0.36em; }
      .st-post { font-size: 5.2vw; line-height: 1.25; max-width: none; }
      .st-cap { margin-top: 0; font-size: 11.5px; line-height: 1.6; max-width: none; }
      .st-title + .st-cap, .st-title + .st-post { margin-top: auto; }
      .st-link { margin-top: 14px; font-size: 13px; padding: 6px 0; }
      #outroLabel { top: 42%; width: calc(100vw - 2 * var(--pad)); }
      #outroBtn { top: 62%; padding: 16px 38px; }
      #ticks { height: 56px; bottom: env(safe-area-inset-bottom); }
      #loaderPct { bottom: var(--bottom); }

      .rs-head { top: calc(var(--top) + 52px); max-width: none; right: var(--pad); }
      .rs-pre, .rs-idx, .rs-unit { font-size: 11px; }
      .rs-title { margin-top: 8px; font-size: min(9.5vw, 42px); }
      .rs-sub { margin-top: 6px; font-size: 13px; }
      .rs-eq { display: none; }
      .rs-stat { top: calc(var(--top) + 168px); bottom: auto; left: var(--pad); right: var(--pad);
        display: flex; align-items: baseline; gap: 10px; text-align: left; flex-wrap: wrap; }
      .rs-num { font-size: min(9vw, 40px); }
      .rs-unit { margin-top: 0; flex: 1 1 0; min-width: 0; line-height: 1.35; }
      .rs-unit .swap, .rs-unit .swap-layer { white-space: normal; }
      #ticks { gap: 2px; } .tick { width: 10px; }
      .rs-legend { width: 100%; justify-content: flex-start; gap: 10px; margin-top: 6px; font-size: 10px; }
      .rs-step { width: auto; right: var(--pad); bottom: calc(var(--bottom) + 46px); }
      .rs-name { margin-top: 6px; font-size: 22px; }
      .rs-text { margin-top: 8px; font-size: 12.5px; line-height: 1.5; min-height: 6em; }
      .rs-bar { margin-top: 12px; }
      .rs-bar i { width: 18px; } .rs-bar i.on { width: 28px; }
      .rs-attr { left: var(--pad); right: auto; bottom: calc(var(--bottom) + 22px); font-size: 9px; }
      .rs-place { font-size: 10px; }
      .rs-place.big { font-size: 12px; }
    }
  </style>
</head>
<body>
  <canvas id="scene" aria-hidden="true"></canvas>

  <div id="loader">
    <div class="loader-grid"></div>
    <div id="loaderBar"></div>
    <div class="logo"><b>alright</b>ansh</div>
    <div id="loaderPct">0%</div>
  </div>

  <header class="top">
    <span class="caps" id="hint"></span>
    <a class="logo" href="/" aria-label="alrightansh home"><b>alright</b>ansh</a>
    <button class="caps" id="audioBtn" type="button" aria-label="Toggle ambient audio">
      <span id="audioLabel"></span><span class="eq" id="eq"><i></i><i></i><i></i></span>
    </button>
  </header>
  <a class="caps bl" href="https://www.linkedin.com/in/alrightansh/" rel="noopener" data-reveal="Share"></a>
  <span class="caps br" data-reveal="Made by Anshuman Choudhary"></span>

  <h1 class="hero" id="heroA" data-text="Anshuman">Anshuman Choudhary</h1>
  <p id="heroP" data-text="Geospatial data scientist from Himachal Pradesh. I migrate utility networks, read the planet from satellites, and tell great stories from complex data through maps."></p>
  <div class="hero" id="heroB" data-text="Choudhary" aria-hidden="true"></div>

  <div id="labels"></div>
  <section id="research" aria-label="Research: soil erosion risk in the Neugal watershed">
    <div class="rs-head">
      <div class="rs-pre" data-reveal-rs="Research work"></div>
      <div class="rs-title" data-reveal-rs="Neugal watershed"></div>
      <div class="rs-sub" data-reveal-rs="Soil erosion risk with RUSLE, AHP and GIS"></div>
    </div>
    <div class="rs-eq" aria-hidden="true"><span data-term="A">A</span> = <span data-term="R">R</span> × <span data-term="K">K</span> × <span data-term="LS">LS</span> × <span data-term="C">C</span> × <span data-term="P">P</span></div>
    <div class="rs-step">
      <div class="rs-idx"></div>
      <div class="rs-name"></div>
      <div class="rs-text"></div>
      <div class="rs-bar"></div>
    </div>
    <div class="rs-stat">
      <div class="rs-num">0</div>
      <div class="rs-unit"></div>
      <div class="rs-legend"></div>
    </div>
    <div class="rs-places" aria-hidden="true"></div>
    <div class="rs-north" aria-hidden="true"><svg viewBox="0 0 20 40"><text x="10" y="9" text-anchor="middle">N</text><path class="nf" d="M10 13 L15 38 L10 33 Z" /><path class="no" d="M10 13 L5 38 L10 33 Z" /></svg></div>
    <div class="rs-scale" aria-hidden="true"><span></span><i></i></div>
    <div class="rs-attr">Elevation: Terrain Tiles (SRTM) · Boundaries: Natural Earth · Map data © <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a> contributors</div>
  </section>
  <div id="outroLabel"></div>
  <a id="outroBtn" href="https://www.linkedin.com/in/alrightansh/" rel="noopener">Say hello</a>
  <nav id="ticks" aria-label="Stops"></nav>

  <script>
    import "../scripts/main.js";
  </script>
</body>
</html>
