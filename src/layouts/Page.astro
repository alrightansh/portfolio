---
// Reading-page shell: head, the flight's chrome (crumb, logo, menu), contact outro and chapter ticks.
import "../styles/base.css";
import "../styles/page.css";
import Cta from "../components/Cta.astro";
import { NAV, SITE, PERSON, LINKS } from "../data/site.js";

interface Props {
  title: string;
  description: string;
  path: string;
  crumb?: { href: string; label: string };
  type?: "website" | "article";
  jsonLd?: object | object[];
}
const { title, description, path, crumb = { href: "/", label: "The flight" }, type = "article", jsonLd } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(path, site).href;
const og = new URL(SITE.og, site).href;
const ld = [
  {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [{ name: "Home", href: "/" }, ...(path === "/work/" ? [] : [{ name: "Work", href: "/work/" }]), { name: title.split(" · ")[0], href: path }]
      .map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.href, site).href })),
  },
  ...(jsonLd ? [jsonLd].flat() : []),
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="author" content={PERSON.name} />
  <meta name="theme-color" content="#07090f" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href="/fonts/OverusedGrotesk-Regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/OverusedGrotesk-Medium.woff2" as="font" type="font/woff2" crossorigin />
  <noscript><link rel="stylesheet" href="/noscript.css" /></noscript>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />
</head>
<body class="page">
  <a class="skip" href="#main">Skip to content</a>
  <div id="bar" aria-hidden="true"></div>

  <header class="top">
    <a class="caps crumb" href={crumb.href}><span aria-hidden="true">← </span>{crumb.label}</a>
    <a class="logo" href="/" aria-label="alrightansh: back to the flight"><b>alright</b>ansh</a>
    <button class="caps" id="menuBtn" type="button" aria-expanded="false" aria-controls="menu">
      <span id="menuLabel">Menu</span><span class="menu-glyph" aria-hidden="true"><i></i><i></i></span>
    </button>
  </header>

  <div class="menu" id="menu" hidden>
    <div class="menu-grid dots" aria-hidden="true"></div>
    <nav aria-label="Site">
      <ol class="menu-list">
        {NAV.map((n, i) => (
          <li>
            <a class="menu-link" href={n.href} aria-current={n.href === path ? "page" : undefined} aria-label={`${n.label}: ${n.note}`}>
              <span class="menu-idx">{String(i).padStart(2, "0")}</span>
              <span class="menu-name">{n.label}</span>
              <span class="menu-note">{n.note}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="menu-foot">
      <a class="link" href={LINKS.linkedin} rel="noopener">LinkedIn <span class="arr ne" aria-hidden="true">↗</span></a>
      <a class="link" href={LINKS.github} rel="noopener">GitHub <span class="arr ne" aria-hidden="true">↗</span></a>
    </div>
  </div>

  <main id="main">
    <slot />
  </main>

  <Cta path={path} />
  <nav id="ticks" aria-label="Chapters"></nav>

  <script>
    import "../scripts/page.js";
  </script>
</body>
</html>
